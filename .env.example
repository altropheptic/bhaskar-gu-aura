# Real values live in Vercel. Get them with:  vercel env pull .env.local
# Never commit .env.local (the repo is public).

# Browser-safe: bundled into the frontend (anything prefixed VITE_ is public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only: read in /api functions, never in /js
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only AI services (used in /api/ai.js and /api/tts.js)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Local only: direct Postgres access (supabase db push, psql)
SUPABASE_DB_PASSWORD=
