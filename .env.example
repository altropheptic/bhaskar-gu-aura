# Get real values with:  vercel env pull .env.local
# (never commit .env.local)

# Browser-safe: bundled into the frontend (anything prefixed VITE_ is public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only: use in /api functions, never in /src
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
