# Real values live in Vercel. Get them with:  vercel env pull .env.local
# Never commit .env.local (the repo is public).

# Browser-safe: bundled into the frontend (anything prefixed VITE_ is public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only: read in /api functions, never in /js
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local only: direct Postgres access (supabase db push, psql)
SUPABASE_DB_PASSWORD=

# AI (optional overrides; AI Gateway auth comes from VERCEL_OIDC_TOKEN via `vercel env pull`)
AI_MODEL=anthropic/claude-opus-5.5
AI_REASONING=high
VERCEL_OIDC_TOKEN=
